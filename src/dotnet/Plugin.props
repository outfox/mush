<Project>

  <PropertyGroup>
    <!-- See https://www.nuget.org/packages/JetBrains.Rider.SDK -->
    <!-- Keep in sync with ProductVersion in gradle.properties -->
    <SdkVersion>2026.2.3.1</SdkVersion>

    <Title>mush</Title>
    <Description>Godot scene editing and C# debugging in Rider, backed by 2dog.</Description>

    <Authors>outfox</Authors>
    <Copyright>Copyright $([System.DateTime]::Now.Year) the mush maintainers</Copyright>
    <PackageTags>rider plugin godot 2dog</PackageTags>

    <PackageProjectUrl>https://github.com/outfox/mush</PackageProjectUrl>
  </PropertyGroup>

</Project>
